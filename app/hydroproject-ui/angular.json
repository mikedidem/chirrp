{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "8e859a4a-c3cc-4ead-9bb0-3aa9e7bf8ff3"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ui-app": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/inter/400.css",
              "node_modules/@fontsource/inter/500.css",
              "node_modules/@fontsource/inter/600.css",
              "node_modules/@fontsource/inter/700.css",
              "src/styles.css"
            ],
            "allowedCommonJsDependencies": ["plotly.js-dist-min"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kB",
                  "maximumError": "32kB"
                }
              ],
              "outputHashing": "all"
            },
            "hosted": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.hosted.ts"
                }
              ],
              "ssr": false,
              "server": false,
              "outputMode": "static",
              "prerender": false,
              "outputHashing": "all",
              "budgets": [
                { "type": "initial", "maximumWarning": "500kB", "maximumError": "1.5MB" }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ui-app:build:production"
            },
            "development": {
              "buildTarget": "ui-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
