# CHIRRP — environment template. Copy to ".env" and fill in as needed.
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)
#
# IMPORTANT: never commit your real .env or any API key. .env is gitignored.

# --- Database -----------------------------------------------------------------
# Used when you run the backend LOCALLY (outside Docker). With `docker compose`
# the backend talks to the db container internally and ignores these.
RAG_DATABASE_URL=postgresql://rag:rag@127.0.0.1:5434/policy_rag
DATABASE_URL=postgresql://rag:rag@127.0.0.1:5434/policy_rag

# --- Gemini API key (OPTIONAL) ------------------------------------------------
# The app runs WITHOUT a key for everything except the Regulations RAG answers:
# scenario chat falls back to regex parsing + template summaries. Provide a key
# only if you want live RAG answers and document re-indexing.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=

# RAG document chunking: "deterministic" needs no API quota (recommended for
# testing). Use "auto" or "llm" only with a billing-enabled Gemini key.
RAG_CHUNK_MODE=deterministic
